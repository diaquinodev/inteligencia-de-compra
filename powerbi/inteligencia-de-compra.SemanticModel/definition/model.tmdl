model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fato_item_compra","dim_item","dim_orgao","dim_tempo","dim_fornecedor","Medidas"]

ref table fato_item_compra
ref table dim_item
ref table dim_orgao
ref table dim_tempo
ref table dim_fornecedor
ref table Medidas

ref cultureInfo pt-BR

