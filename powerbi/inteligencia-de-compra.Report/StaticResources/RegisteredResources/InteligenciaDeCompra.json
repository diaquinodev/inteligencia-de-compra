{
  "name": "InteligenciaDeCompra",
  "dataColors": [
    "#1D4ED8",
    "#15803D",
    "#B45309",
    "#7C3AED",
    "#0E7490",
    "#BE123C",
    "#9CA3AF",
    "#4D7C0F"
  ],
  "background": "#FFFFFF",
  "foreground": "#111827",
